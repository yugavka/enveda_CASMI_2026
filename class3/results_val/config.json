    "hydrogenation",
    "dehydrogenation",
    "dehydrogenation_ring",
    "ketone_from_alcohol",
    "alcohol_from_ketone",
    "hexosylation",
    "pentosylation",
    "deoxyhexosylation",
    "glucuronidation",
    "dehexosylation",
    "depentosylation",
    "dedeoxyhexosylation",
    "acetylation",
    "deacetylation",
    "malonylation",
    "sulfation",
    "prenylation_ar",
    "decarboxylation",
    "carboxylic_from_methyl",
    "hydration",
    "dehydration"
