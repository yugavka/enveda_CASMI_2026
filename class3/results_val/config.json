{
  "data": "data/train.parquet",
  "cache": "data/cache",
  "out": "class3/results_val",
  "limit": 0,
  "source": "val_np",
  "n": 400,
  "seed": 0,
  "model": "data/models/sanpier/casmi_spectrum_model_v1",
