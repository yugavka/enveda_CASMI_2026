{
  "data": "data/train.parquet",
  "cache": "data/cache",
  "out": "class3/results_rank_train",
  "limit": 0,
  "source": "val_np",
  "n": 1600,
  "seed": 1,
  "model": "data/models/sanpier/casmi_spectrum_model_v1",
  "checkpoint": "best_validation_model.pt",
  "k": 30,
  "steps": 2,
  "exclude": "class3/results_rank_eval/per_query.csv",
  "no_np_first": true,
  "workers": 14,
  "thresholds": [
    1.0,
    0.85,
    0.7
  ],
  "cap": 150,
  "rules": [
    "hydroxylation_ar",
    "hydroxylation_al",
    "dehydroxylation",
    "o_methylation",
    "n_methylation",
    "o_demethylation",
    "n_demethylation",
    "methoxylation_ar",
    "hydrogenation",
    "dehydrogenation",
    "dehydrogenation_ring",
    "ketone_from_alcohol",
    "alcohol_from_ketone",
    "hexosylation",
    "pentosylation",
    "deoxyhexosylation",
    "glucuronidation",
    "dehexosylation",
    "depentosylation",
    "dedeoxyhexosylation",
    "acetylation",
    "deacetylation",
    "malonylation",
    "sulfation",
    "prenylation_ar",
    "decarboxylation",
    "carboxylic_from_methyl",
    "hydration",
    "dehydration",
    "c_methylation_al",
    "c_methylation_ar",
    "c_demethylation",
    "ethylation",
    "propylation",
    "amine_to_hydroxyl",
    "hydroxyl_to_amine",
    "amide_to_acid",
    "acid_to_amide",
    "formylation",
    "carbamoylation",
    "aza_ar"
  ]
}